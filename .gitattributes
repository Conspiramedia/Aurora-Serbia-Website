# Автоматически определять текстовые файлы и нормализовать переносы строк к LF в репозитории
* text=auto eol=lf

# Явно текстовые форматы
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.xml    text eol=lf
*.svg    text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.webmanifest text eol=lf
*.htaccess    text eol=lf
CNAME    text eol=lf

# Бинарные файлы — git не трогает переносы строк
*.webp   binary
*.png    binary
*.ico    binary
*.woff2  binary
